<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 12px;
            color: #1f2937;
            margin: 0;
            padding: 40px;
        }
        .header {
            border-bottom: 3px solid #d97706;
            padding-bottom: 16px;
            margin-bottom: 28px;
        }
        .header table { width: 100%; }
        .brand { font-size: 22px; font-weight: bold; color: #b45309; }
        .brand-sub { color: #6b7280; font-size: 11px; }
        .invoice-title { text-align: right; }
        .invoice-title h1 { margin: 0; font-size: 20px; color: #111827; }
        .invoice-title .meta { color: #6b7280; font-size: 11px; margin-top: 4px; }

        .cols { width: 100%; margin-bottom: 28px; }
        .cols td { vertical-align: top; width: 50%; padding-right: 20px; }
        .label { text-transform: uppercase; font-size: 10px; letter-spacing: .5px; color: #9ca3af; margin-bottom: 6px; font-weight: bold; }
        .block-content { line-height: 1.5; }

        table.items { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
        table.items thead th {
            background: #fef3c7;
            color: #92400e;
            text-align: left;
            padding: 9px 12px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .3px;
        }
        table.items thead th.right,
        table.items tbody td.right { text-align: right; }
        table.items tbody td { padding: 9px 12px; border-bottom: 1px solid #f0f0f0; }

        .totals { width: 100%; }
        .totals td { padding: 0; }
        .totals .spacer { width: 60%; }
        table.totals-box { width: 40%; border-collapse: collapse; margin-left: auto; }
        table.totals-box td { padding: 7px 12px; }
        table.totals-box tr.grand td {
            border-top: 2px solid #d97706;
            font-weight: bold;
            font-size: 14px;
            color: #b45309;
        }

        .footer {
            margin-top: 40px;
            padding-top: 14px;
            border-top: 1px solid #e5e7eb;
            color: #9ca3af;
            font-size: 10px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="header">
        <table>
            <tr>
                <td>
                    <div class="brand">Rucher du Loison</div>
                    <div class="brand-sub">Miels artisanaux récoltés avec passion</div>
                </td>
                <td class="invoice-title">
                    <h1>FACTURE</h1>
                    <div class="meta">
                        N° {{ 'facture-%05d'|format(order.id) }}<br>
                        Date : {{ order.createdAt|date('d/m/Y') }}
                    </div>
                </td>
            </tr>
        </table>
    </div>

    <table class="cols">
        <tr>
            <td>
                <div class="label">Vendeur</div>
                <div class="block-content">
                    <strong>Rucher du Loison</strong><br>
                    Le Rucher des Collines<br>
                    France<br>
                    contact@rucher-du-loison.fr
                </div>
            </td>
            <td>
                <div class="label">Facturé à</div>
                <div class="block-content">
                    <strong>{{ order.deliveryFirstName }} {{ order.deliveryLastName }}</strong><br>
                    {{ order.deliveryStreet }}<br>
                    {{ order.deliveryPostalCode }} {{ order.deliveryCity }}<br>
                    {{ order.deliveryCountry }}<br>
                    {{ order.user.email }}
                </div>
            </td>
        </tr>
    </table>

    <table class="items">
        <thead>
            <tr>
                <th>Produit</th>
                <th class="right">Prix unitaire</th>
                <th class="right">Qté</th>
                <th class="right">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for item in order.orderItems %}
                <tr>
                    <td>
                        {{ item.productVariant.product.name }}
                        <span style="color:#9ca3af;">— {{ item.productVariant.weight }} g</span>
                    </td>
                    <td class="right">{{ item.unitPrice|number_format(2, ',', ' ') }} €</td>
                    <td class="right">{{ item.quantity }}</td>
                    <td class="right">{{ (item.unitPrice * item.quantity)|number_format(2, ',', ' ') }} €</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <table class="totals">
        <tr>
            <td class="spacer"></td>
            <td>
                <table class="totals-box">
                    <tr>
                        <td>Sous-total</td>
                        <td class="right">{{ order.totalPrice|number_format(2, ',', ' ') }} €</td>
                    </tr>
                    <tr>
                        <td>Livraison</td>
                        <td class="right">Offerte</td>
                    </tr>
                    <tr class="grand">
                        <td>Total TTC</td>
                        <td class="right">{{ order.totalPrice|number_format(2, ',', ' ') }} €</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <div class="footer">
        Facture générée le {{"now"|date('d/m/Y à H:i') }}
    </div>

</body>
</html>
