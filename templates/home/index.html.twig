{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}
{% block meta_description %}Miels artisanaux récoltés avec passion, de nos ruches à votre table. Découvrez nos best-sellers et nos promotions.{% endblock %}

{% block body %}

<section class="relative text-white overflow-hidden"
         style="background-image: url('/images/hero-bee.jpg'); background-size: cover; background-position: center;">
    <div class="max-w-6xl mx-auto px-6 py-24 text-center relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">Le miel, brut et authentique</h1>
        <p class="text-amber-50 text-lg max-w-xl mx-auto mb-8">
            Récolté avec passion, sans transformation industrielle.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="{{ path('app_shop_index') }}"
               class="bg-white text-amber-700 hover:bg-amber-50 font-semibold px-8 py-3 rounded-lg">
                Découvrir nos miels
            </a>
            <a href="{{ path('app_about') }}"
               class="border border-white/60 text-white hover:bg-white/10 font-semibold px-8 py-3 rounded-lg">
                Notre exploitation
            </a>
        </div>
    </div>
</section>

{% if bestSellers is not empty %}
<section class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex items-end justify-between mb-8">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">Nos best-sellers</h2>
            <p class="text-gray-500 text-sm mt-1">Les miels préférés de nos clients.</p>
        </div>
        <a href="{{ path('app_shop_index') }}" class="text-sm font-medium text-amber-600 hover:text-amber-700 shrink-0">Tout voir →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for product in bestSellers %}
            {{ include('product/_card.html.twig', { product: product }) }}
        {% endfor %}
    </div>
</section>
{% endif %}

<section class="bg-white border-y border-amber-100">
    <div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
        <div>
            <span class="text-xs font-semibold text-amber-600 uppercase tracking-wider">Notre histoire</span>
            <h2 class="text-2xl font-bold text-gray-900 mt-2 mb-4">Une passion familiale pour l'abeille</h2>
            <p class="text-gray-600 leading-relaxed mb-4">
                Installés au cœur de la nature, nous élevons nos abeilles dans le respect de leur rythme et
                de leur environnement.
            <p class="text-gray-600 leading-relaxed mb-6">
                Pas de chauffage, pas de mélange : un miel naturel, tel que la ruche l'a produit.
            </p>
            <a href="{{ path('app_about') }}"
               class="inline-block bg-amber-600 hover:bg-amber-700 text-white font-semibold px-6 py-3 rounded-lg">
                En savoir plus
            </a>
        </div>
        <img src="/images/histoire-bee.jpg" alt="Abeille butinant une fleur"
             class="aspect-[4/3] w-full object-cover rounded-lg border border-gray-200">
    </div>
</section>

{% if promos is not empty %}
<section class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex items-end justify-between mb-8">
        <div>
            <h2 class="text-2xl font-bold text-gray-900">En promotion</h2>
            <p class="text-gray-500 text-sm mt-1">Profitez de nos offres du moment.</p>
        </div>
        <a href="{{ path('app_shop_index') }}" class="text-sm font-medium text-green-600 hover:text-green-700 shrink-0">Tout voir →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for product in promos %}
            {{ include('product/_card.html.twig', { product: product }) }}
        {% endfor %}
    </div>
</section>
{% endif %}

<section class="bg-amber-700 text-white">
    <div class="max-w-4xl mx-auto px-6 py-16 text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Envie de goûter la différence ?</h2>
        <p class="text-amber-100 mb-8">Parcourez notre boutique et trouvez le miel fait pour vous.</p>
        <a href="{{ path('app_shop_index') }}"
           class="inline-block bg-white text-amber-700 hover:bg-amber-50 font-semibold px-8 py-3 rounded-lg">
            Voir tous nos miels
        </a>
    </div>
</section>

{% endblock %}
