{% extends 'admin/layout.html.twig' %}

{% block title %}Éditer {{ user.firstName }}{% endblock %}
{% block page_title %}Éditer un utilisateur{% endblock %}

{% block admin_content %}
<div class="mb-6">
    <a href="{{ path('admin_user_index') }}" class="text-sm text-gray-500 hover:text-amber-600">← Retour aux utilisateurs</a>
</div>

<div class="max-w-xl">
    {% if errors is not empty %}
        <div class="bg-red-50 border-l-4 border-red-400 text-red-800 text-sm px-4 py-3 rounded mb-6">
            <ul class="list-disc list-inside space-y-1">
                {% for error in errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="POST" class="bg-white rounded-xl border border-gray-200 p-6 space-y-5">
        <input type="hidden" name="_token" value="{{ csrf_token('edit_user_' ~ user.id) }}">

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
            <input type="email" value="{{ user.email }}" disabled
                   class="w-full border border-gray-200 bg-gray-50 text-gray-500 rounded-lg px-4 py-2.5 text-sm">
        </div>

        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1.5">Prénom</label>
                <input type="text" id="firstName" name="firstName" value="{{ user.firstName }}" required
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
            </div>
            <div>
                <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1.5">Nom</label>
                <input type="text" id="lastName" name="lastName" value="{{ user.lastName }}" required
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
            </div>
        </div>

        <label class="flex items-center gap-3 text-sm text-gray-700">
            <input type="checkbox" name="isAdmin" {{ 'ROLE_ADMIN' in user.roles ? 'checked' }}
                   class="rounded border-gray-300 text-amber-600 focus:ring-amber-400">
            Administrateur
        </label>

        <label class="flex items-center gap-3 text-sm text-gray-700">
            <input type="checkbox" name="isActive" {{ user.isActive ? 'checked' }}
                   class="rounded border-gray-300 text-amber-600 focus:ring-amber-400">
            Compte actif
        </label>

        {% if user == app.user %}
            <p class="text-xs text-amber-600">Vous éditez votre propre compte : vous ne pouvez pas retirer votre rôle admin ni le désactiver.</p>
        {% endif %}

        <button type="submit"
                class="bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors">
            Enregistrer
        </button>
    </form>
</div>
{% endblock %}
