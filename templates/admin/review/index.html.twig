{% extends 'admin/layout.html.twig' %}

{% block title %}Avis{% endblock %}
{% block page_title %}Avis clients{% endblock %}

{% block admin_content %}
<p class="text-sm text-gray-500 mb-6">
    {{ reviews|length }} avis au total ·
    {% if pendingCount > 0 %}
        <span class="font-medium text-amber-700">{{ pendingCount }} en attente de modération</span>
    {% else %}
        <span class="text-green-600">aucun en attente</span>
    {% endif %}
</p>

{% if reviews is empty %}
    <div class="bg-white rounded-xl border border-gray-200 p-12 text-center text-gray-400">
        Aucun avis pour l'instant.
    </div>
{% else %}
    <div class="space-y-3">
        {% for review in reviews %}
        <div class="bg-white rounded-xl border p-5 {{ review.isApprouved ? 'border-gray-200' : 'border-amber-300 bg-amber-50/40' }}">
            <div class="flex flex-wrap items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-3 mb-1">
                        <span class="text-amber-400 text-sm">
                            {% for i in 1..5 %}{% if i <= review.rating %}★{% else %}☆{% endif %}{% endfor %}
                        </span>
                        {% if review.isApprouved %}
                            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-100 text-green-700">Publié</span>
                        {% else %}
                            <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">En attente</span>
                        {% endif %}
                    </div>
                    <p class="text-sm text-gray-700">
                        <strong>{{ review.product.name }}</strong>
                        <span class="text-gray-400">— {{ review.user.firstName }} {{ review.user.lastName }} · {{ review.createdAt|date('d/m/Y') }}</span>
                    </p>
                    {% if review.comment %}
                        <p class="text-sm text-gray-600 mt-2 leading-relaxed">{{ review.comment }}</p>
                    {% else %}
                        <p class="text-sm text-gray-400 italic mt-2">(pas de commentaire)</p>
                    {% endif %}
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    {% if not review.isApprouved %}
                        <form method="POST" action="{{ path('admin_review_approve', { id: review.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('approve_review_' ~ review.id) }}">
                            <button type="submit"
                                    class="text-xs font-medium bg-green-600 hover:bg-green-700 text-white px-3 py-1.5 rounded-lg transition-colors">
                                Approuver
                            </button>
                        </form>
                    {% endif %}
                    <form method="POST" action="{{ path('admin_review_delete', { id: review.id }) }}"
                          onsubmit="return confirm('Supprimer définitivement cet avis ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_review_' ~ review.id) }}">
                        <button type="submit"
                                class="text-xs font-medium text-red-500 hover:text-red-700 transition-colors px-2 py-1.5">
                            Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
