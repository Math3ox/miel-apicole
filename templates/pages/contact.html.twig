{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}
{% block meta_description %}Une question sur nos miels ou une commande ? Contactez l'équipe Rucher du Loison via notre formulaire.{% endblock %}

{% block body %}

<section class="max-w-2xl mx-auto px-6 py-14">

    <div class="text-center mb-10">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">Contactez-nous</h1>
        <p class="text-gray-500">Une question, une demande spéciale ? Écrivez-nous, nous répondons vite.</p>
    </div>

    {% if errors is not empty %}
        <div class="bg-red-50 border-l-4 border-red-400 text-red-800 text-sm px-4 py-3 rounded mb-6">
            <ul class="list-disc list-inside space-y-1">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <form method="POST" action="{{ path('app_contact') }}" class="bg-white rounded-lg border border-gray-200 p-8 space-y-5">
        <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">Nom</label>
                <input type="text" id="name" name="name" value="{{ data.name }}" required
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent">
            </div>
            <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                <input type="email" id="email" name="email" value="{{ data.email }}" required
                       class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent">
            </div>
        </div>

        <div>
            <label for="subject" class="block text-sm font-medium text-gray-700 mb-1.5">Sujet <span class="text-gray-400 font-normal">(optionnel)</span></label>
            <input type="text" id="subject" name="subject" value="{{ data.subject }}"
                   class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent">
        </div>

        <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">Message</label>
            <textarea id="message" name="message" rows="5" required
                      class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent">{{ data.message }}</textarea>
        </div>

        <button type="submit"
                class="w-full bg-amber-600 hover:bg-amber-700 text-white font-semibold py-3 rounded-lg">
            Envoyer le message
        </button>
    </form>

    <div class="text-center text-sm text-gray-500 mt-8">
        Vous pouvez aussi nous écrire directement à
        <a href="mailto:contact@rucher-du-loison.fr" class="text-amber-600 hover:underline">contact@rucher-du-loison.fr</a>
    </div>

</section>

{% endblock %}
