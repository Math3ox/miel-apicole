{% extends 'base.html.twig' %}

{% block title %}Mes commandes{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-6 py-12">

    <nav class="text-sm text-gray-500 mb-6">
        <a href="{{ path('app_account_index') }}" class="hover:text-amber-600">Mon compte</a>
        <span class="mx-2">/</span>
        <span class="text-gray-700">Mes commandes</span>
    </nav>

    <h1 class="text-2xl font-bold text-gray-900 mb-8">Historique de mes commandes</h1>

    {% if orders is empty %}
        <div class="bg-white rounded-lg border border-gray-200 p-10 text-center">
            <p class="text-gray-500 mb-4">Vous n'avez pas encore passé de commande.</p>
            <a href="{{ path('app_shop_index') }}"
               class="inline-block bg-amber-600 hover:bg-amber-700 text-white font-semibold px-6 py-3 rounded-lg">
                Découvrir nos miels
            </a>
        </div>
    {% else %}
        <div class="space-y-3">
            {% for order in orders %}
                {{ include('account/_order_row.html.twig', { order: order }) }}
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}
