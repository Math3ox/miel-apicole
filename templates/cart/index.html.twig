{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto px-6 py-10">

    <h1 class="text-2xl font-bold text-gray-900 mb-8">Mon panier</h1>

    {% if items is empty %}
        <div class="text-center py-20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-gray-200 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2 9m12-9l2 9m-5-9v9m-4-9v9"/>
            </svg>
            <p class="text-gray-400 text-lg mb-6">Votre panier est vide.</p>
            <a href="{{ path('app_shop_index') }}" class="inline-block bg-amber-500 hover:bg-amber-600 text-white font-semibold px-6 py-3 rounded-lg">
                Découvrir nos miels
            </a>
        </div>
    {% else %}
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <div class="lg:col-span-2 space-y-4">
                {% for item in items %}
                    {% set variant = item.variant %}
                    {% set product = variant.product %}
                    <div class="bg-white rounded-lg border border-gray-200 p-5 flex gap-4 items-start">

                        <a href="{{ path('app_shop_show', {slug: product.slug}) }}" class="shrink-0">
                            {% if product.image %}
                                <img src="/uploads/products/{{ product.image }}"
                                     alt="{{ product.name }}"
                                     class="w-20 h-20 object-cover rounded-lg border border-gray-100">
                            {% else %}
                                <div class="w-20 h-20 rounded-lg bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-300">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                            {% endif %}
                        </a>

                        <div class="flex-1 min-w-0">
                            <a href="{{ path('app_shop_show', {slug: product.slug}) }}" class="font-semibold text-gray-900 hover:text-amber-600 text-sm leading-snug">
                                {{ product.name }}
                            </a>
                            <p class="text-xs text-gray-400 mt-0.5">{{ variant.weight }} g — {{ variant.price|number_format(2, ',', ' ') }} €/unité</p>

                            <div class="flex items-center gap-3 mt-3">
                                <form method="POST" action="{{ path('app_cart_update') }}" class="flex items-center gap-2">
                                    <input type="hidden" name="variant_id" value="{{ variant.id }}">
                                    <label class="sr-only" for="qty-{{ variant.id }}">Quantité</label>
                                    <select id="qty-{{ variant.id }}" name="quantity"
                                            onchange="this.form.submit()"
                                            class="border border-gray-200 rounded-lg text-sm px-2 py-1.5 text-gray-700 bg-white focus:outline-none focus:ring-2 focus:ring-amber-300">
                                        {% for q in 1..10 %}
                                            <option value="{{ q }}" {{ q == item.quantity ? 'selected' }}>{{ q }}</option>
                                        {% endfor %}
                                    </select>
                                </form>

                                <form method="POST" action="{{ path('app_cart_remove', {variantId: variant.id}) }}">
                                    <button type="submit" class="text-xs text-gray-400 hover:text-red-500 underline underline-offset-2">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>

                        <div class="shrink-0 text-right">
                            <p class="font-bold text-gray-900">{{ item.subtotal|number_format(2, ',', ' ') }} €</p>
                        </div>
                    </div>
                {% endfor %}

                <div class="text-right pt-1">
                    <form method="POST" action="{{ path('app_cart_clear') }}">
                        <button type="submit" class="text-xs text-gray-400 hover:text-red-500 underline underline-offset-2">
                            Vider le panier
                        </button>
                    </form>
                </div>
            </div>

            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg border border-gray-200 p-6">
                    <h2 class="font-bold text-gray-900 text-lg mb-5">Récapitulatif</h2>

                    <div class="space-y-2 text-sm text-gray-600 mb-5">
                        {% for item in items %}
                            <div class="flex justify-between">
                                <span class="truncate pr-2">{{ item.variant.product.name }} ({{ item.variant.weight }}g) × {{ item.quantity }}</span>
                                <span class="shrink-0 font-medium text-gray-800">{{ item.subtotal|number_format(2, ',', ' ') }} €</span>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="border-t border-gray-100 pt-4 mb-6">
                        <div class="flex justify-between font-bold text-gray-900 text-base">
                            <span>Total</span>
                            <span class="text-amber-700">{{ total|number_format(2, ',', ' ') }} €</span>
                        </div>
                        <p class="text-xs text-gray-400 mt-1">Livraison calculée à l'étape suivante</p>
                    </div>

                    <a href="{{ path('app_checkout_index') }}"
                       class="block w-full text-center bg-amber-600 hover:bg-amber-700 text-white font-semibold py-3 rounded-lg">
                        Passer la commande
                    </a>

                    <a href="{{ path('app_shop_index') }}" class="block text-center text-sm text-gray-400 hover:text-amber-600 mt-3">
                        Continuer mes achats
                    </a>
                </div>
            </div>

        </div>
    {% endif %}
</div>
{% endblock %}
