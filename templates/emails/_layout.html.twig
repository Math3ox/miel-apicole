<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0; padding:0; background-color:#fffbeb; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fffbeb; padding:24px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:16px; overflow:hidden; border:1px solid #fde68a;">

                    <tr>
                        <td style="background-color:#b45309; padding:24px 32px;">
                            <span style="font-size:22px; font-weight:bold; color:#ffffff;">🍯 Miel Apicole</span>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:32px;">
                            {% block content %}{% endblock %}
                        </td>
                    </tr>

                    <tr>
                        <td style="background-color:#1f2937; padding:20px 32px; text-align:center;">
                            <p style="margin:0; font-size:12px; color:#9ca3af;">
                                Miel Apicole — Miels artisanaux récoltés avec passion<br>
                                Cet e-mail vous a été envoyé suite à une action sur notre site.
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
