{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:20px; color:#111827;">Merci pour votre commande !</h1>

    <p style="margin:0 0 20px; font-size:14px; line-height:1.6; color:#374151;">
        Bonjour {{ order.user.firstName }}, nous avons bien reçu votre commande
        <strong>#{{ order.id }}</strong> passée le {{ order.createdAt|date('d/m/Y') }}.
        Vous trouverez votre facture en pièce jointe.
    </p>

    {# Récapitulatif #}
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin-bottom:20px;">
        <tr>
            <td style="padding:8px 0; border-bottom:2px solid #fde68a; font-size:12px; text-transform:uppercase; color:#92400e; font-weight:bold;">Produit</td>
            <td style="padding:8px 0; border-bottom:2px solid #fde68a; font-size:12px; text-transform:uppercase; color:#92400e; font-weight:bold; text-align:right;">Total</td>
        </tr>
        {% for item in order.orderItems %}
        <tr>
            <td style="padding:8px 0; border-bottom:1px solid #f3f4f6; font-size:14px; color:#374151;">
                {{ item.productVariant.product.name }}
                <span style="color:#9ca3af;">({{ item.productVariant.weight }} g) &times; {{ item.quantity }}</span>
            </td>
            <td style="padding:8px 0; border-bottom:1px solid #f3f4f6; font-size:14px; color:#374151; text-align:right;">
                {{ (item.unitPrice * item.quantity)|number_format(2, ',', ' ') }} &euro;
            </td>
        </tr>
        {% endfor %}
        <tr>
            <td style="padding:12px 0 0; font-size:15px; font-weight:bold; color:#111827;">Total</td>
            <td style="padding:12px 0 0; font-size:15px; font-weight:bold; color:#b45309; text-align:right;">
                {{ order.totalPrice|number_format(2, ',', ' ') }} &euro;
            </td>
        </tr>
    </table>

    {# Adresse #}
    <p style="margin:0 0 6px; font-size:12px; text-transform:uppercase; color:#9ca3af; font-weight:bold;">Livraison à</p>
    <p style="margin:0 0 24px; font-size:14px; line-height:1.6; color:#374151;">
        {{ order.deliveryFirstName }} {{ order.deliveryLastName }}<br>
        {{ order.deliveryStreet }}<br>
        {{ order.deliveryPostalCode }} {{ order.deliveryCity }}<br>
        {{ order.deliveryCountry }}
    </p>

    <table role="presentation" cellpadding="0" cellspacing="0">
        <tr>
            <td style="background-color:#d97706; border-radius:10px;">
                <a href="{{ url('app_account_order_show', { id: order.id }) }}"
                   style="display:inline-block; padding:12px 24px; font-size:14px; font-weight:bold; color:#ffffff; text-decoration:none;">
                    Suivre ma commande
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
