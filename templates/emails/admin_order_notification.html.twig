{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:20px; color:#111827;">Nouvelle commande #{{ order.id }}</h1>

    <p style="margin:0 0 20px; font-size:14px; line-height:1.6; color:#374151;">
        Une nouvelle commande vient d'être passée le {{ order.createdAt|date('d/m/Y à H:i') }} par
        <strong>{{ order.user.firstName }} {{ order.user.lastName }}</strong> ({{ order.user.email }}).
    </p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse; margin-bottom:20px;">
        {% for item in order.orderItems %}
        <tr>
            <td style="padding:6px 0; border-bottom:1px solid #f3f4f6; font-size:14px; color:#374151;">
                {{ item.productVariant.product.name }}
                <span style="color:#9ca3af;">({{ item.productVariant.weight }} g) &times; {{ item.quantity }}</span>
            </td>
            <td style="padding:6px 0; border-bottom:1px solid #f3f4f6; font-size:14px; color:#374151; text-align:right;">
                {{ (item.unitPrice * item.quantity)|number_format(2, ',', ' ') }} &euro;
            </td>
        </tr>
        {% endfor %}
        <tr>
            <td style="padding:10px 0 0; font-size:15px; font-weight:bold; color:#111827;">Total</td>
            <td style="padding:10px 0 0; font-size:15px; font-weight:bold; color:#b45309; text-align:right;">
                {{ order.totalPrice|number_format(2, ',', ' ') }} &euro;
            </td>
        </tr>
    </table>

    <table role="presentation" cellpadding="0" cellspacing="0">
        <tr>
            <td style="background-color:#d97706; border-radius:10px;">
                <a href="{{ url('admin_order_show', { id: order.id }) }}"
                   style="display:inline-block; padding:12px 24px; font-size:14px; font-weight:bold; color:#ffffff; text-decoration:none;">
                    Gérer la commande
                </a>
            </td>
        </tr>
    </table>
{% endblock %}
