{% extends 'emails/_layout.html.twig' %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:20px; color:#111827;">Nouveau message de contact</h1>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
        <tr>
            <td style="padding:6px 0; font-size:14px; color:#9ca3af; width:90px;">Nom</td>
            <td style="padding:6px 0; font-size:14px; color:#374151;"><strong>{{ name }}</strong></td>
        </tr>
        <tr>
            <td style="padding:6px 0; font-size:14px; color:#9ca3af;">Email</td>
            <td style="padding:6px 0; font-size:14px; color:#374151;">{{ email }}</td>
        </tr>
        {% if subject %}
        <tr>
            <td style="padding:6px 0; font-size:14px; color:#9ca3af;">Sujet</td>
            <td style="padding:6px 0; font-size:14px; color:#374151;">{{ subject }}</td>
        </tr>
        {% endif %}
    </table>

    <p style="margin:0 0 6px; font-size:12px; text-transform:uppercase; color:#9ca3af; font-weight:bold;">Message</p>
    <p style="margin:0; font-size:14px; line-height:1.6; color:#374151; white-space:pre-line;">{{ message }}</p>
{% endblock %}
